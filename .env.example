# ========================================================
# CẤU HÌNH XÁC THỰC GOOGLE OAUTH CHO BOARD GAME SPLENDOR
# ========================================================

# 1. Cổng máy chủ Socket.IO (mặc định 3000)
PORT=3000

# 2. Google OAuth 2.0 Client ID (Lấy từ https://console.cloud.google.com/apis/credentials)
# Ví dụ: 123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# 3. Google OAuth 2.0 Client Secret (Tùy chọn)
GOOGLE_CLIENT_SECRET=
